# Server Configuration
PORT=3000

# BMS Serial Port Configuration
SERIAL_PORT=COM3
BAUD_RATE=115200
MODBUS_SLAVE_ID=1

# Polling and Timeout Configuration
POLL_INTERVAL_MS=15000
MODBUS_TIMEOUT_MS=400

# Database Configuration
DB_PATH=./data/bms_log.db
LOG_RETENTION_DAYS=30

# Battery & Health Configuration
BATTERY_NOMINAL_CAP_AH=100
BATTERY_MAX_CYCLES=3000
BATTERY_EOL_SOH=70
BATTERY_CYCLES_PER_MONTH=15

# Electricity Tariff Configuration (บาท / kWh)
ELECTRICITY_RATE_THB=4.5
ELECTRICITY_CHARGE_RATE_THB=4.5
ELECTRICITY_DISCHARGE_RATE_THB=4.5

# Environmental / Carbon Offset Configuration (kg CO2 / kWh)
# ค่าสัมประสิทธิ์การปล่อยก๊าซเรือนกระจกของการไฟฟ้าไทย (TGO / EPPO ~0.4999 kgCO2e/kWh)
CO2_EMISSION_FACTOR=0.4999

